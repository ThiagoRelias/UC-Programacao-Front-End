-- 5 
   
function gerarTextoCompras2(itens, formato) {
    if (formato === "texto") {
        return itens.join(", ");
    }
    if (formato === "lista") {
        let resultado = "";
        for (let i = 0; i < itens.length; i++) {
            resultado += "• " + itens[i];
            if (i < itens.length - 1) {
                resultado += "\n";
            }
        }
        return resultado;
    }
    return "Formato inválido.";
}
let compras2 = [
    "Arroz",
    "Feijão",
    "Macarrão"
];
console.log("EXERCÍCIO 5");
console.log(gerarTextoCompras2(compras2, "texto"));
console.log(gerarTextoCompras2(compras2, "lista"));


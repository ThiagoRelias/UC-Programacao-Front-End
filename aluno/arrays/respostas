function somenteNumeros(array) {
    let numeros = [];
    for (let i = 0; i < array.length; i++) {
        if (typeof array[i] === "number") {
            numeros.push(array[i]);
        }
    }
    return numeros;
}
let valores = [10, "Olá", 20, true, 30, "JavaScript", 40];
let resultadoNumeros = somenteNumeros(valores);
console.log("EXERCÍCIO 2");
console.log("Valores numéricos:", resultadoNumeros);

-- 3 
    
function adicionarPedido(pedidos, codigo) {
    if (pedidos.length === 10) {
        pedidos.shift();
    }
    pedidos.push(codigo);
    return pedidos;
}
let pedidos = [
    "0001",
    "0002",
    "0003",
    "0004",
    "0005"
];
let codigo = prompt("EXERCÍCIO 3\nDigite o código do pedido com 4 dígitos:");
if (/^\d{4}$/.test(codigo)) {
    pedidos = adicionarPedido(pedidos, codigo);
    console.log("EXERCÍCIO 3");
    console.log("Histórico de pedidos:");
    console.log(pedidos);
} else {
    alert("Código inválido! Digite exatamente 4 números.");
}


function concatenar3(palavra1, palavra2, palavra3, separador = " | ") {
    if (
        typeof palavra1 !== "string" ||
        typeof palavra2 !== "string" ||
        typeof palavra3 !== "string" ||
        typeof separador !== "string"
    ) {
        return "Os parâmetros devem ser textos.";
    }

    return palavra1 + separador + palavra2 + separador + palavra3;
}
console.log(concatenar3("JavaScript", "HTML", "CSS"));
console.log(concatenar3("JavaScript", "HTML", "CSS", " - "));




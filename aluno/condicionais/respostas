function retornarQuantidadeDeGasolina(quilometros, consumo) {
    if (
        typeof quilometros !== "number" ||
        typeof consumo !== "number" ||
        !Number.isFinite(quilometros) ||
        !Number.isFinite(consumo) ||
        quilometros < 0 ||
        consumo <= 0
    ) {
        return "Digite valores válidos.";
    }

    let distanciaTotal = quilometros * 2;
    let gasolina = (distanciaTotal / 100) * consumo;

    return gasolina;
}
console.log(retornarQuantidadeDeGasolina(300, 10));




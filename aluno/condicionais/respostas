function precoParcela(precoTotal, parcelas = 1) {
    if (
        typeof precoTotal !== "number" ||
        !Number.isFinite(precoTotal) ||
        precoTotal < 0
    ) {
        return "Preço inválido.";
    }

    if (
        typeof parcelas !== "number" ||
        !Number.isInteger(parcelas) ||
        parcelas <= 0
    ) {
        return "Quantidade de parcelas inválida.";
    }

    if (parcelas > 12) {
        return precoTotal;
    }

    return precoTotal / parcelas;
}
console.log(precoParcela(1200, 6)); 
console.log(precoParcela(1200, 12)); 
console.log(precoParcela(1200, 15)); 
console.log(precoParcela(500)); 





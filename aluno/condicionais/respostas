function aplicarCupomDesconto(valorTotal, cupom) {
    if (
        typeof valorTotal !== "number" ||
        !Number.isFinite(valorTotal) ||
        valorTotal < 0
    ) {
        return "Valor total inválido.";
    }

    if (typeof cupom !== "string") {
        return "O cupom deve ser uma string.";
    }

    if (cupom === "CUPOM50") {
        return aplicarDesconto(valorTotal, 50);
    }

    if (cupom === "CUPOM100") {
        return aplicarDesconto(valorTotal, 100);
    }

    if (cupom === "CUPOM200") {
        return aplicarDesconto(valorTotal, 200);
    }

    return valorTotal;
}


function converterMinutosParaHoras(minutos) {
    if (typeof minutos !== "number" || !Number.isFinite(minutos) || minutos < 0) {
        return "Digite uma quantidade válida de minutos.";
    }

    let horas = minutos / 60;

    return horas;
}

console.log(converterMinutosParaHoras(120));
console.log(converterMinutosParaHoras(90));




function maiorNumero(numero1, numero2, numero3) {
    if (
        typeof numero1 !== "number" ||
        typeof numero2 !== "number" ||
        typeof numero3 !== "number" ||
        !Number.isFinite(numero1) ||
        !Number.isFinite(numero2) ||
        !Number.isFinite(numero3)
    ) {
        console.log("Todos os valores devem ser números.");
        return;
    }
    let maior = numero1;

    if (numero2 > maior) {
        maior = numero2;
    }

    if (numero3 > maior) {
        maior = numero3;
    }
    console.log("O maior número é:", maior);
}
maiorNumero(10, 25, 18);


